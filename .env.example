# 复制为 .env 后按需修改（compose 可在 yml 中注入；单独部署 Label Studio 时见 README）
WORKSHOP_LABEL_STUDIO_URL=http://host.docker.internal:8080
WORKSHOP_WORKSPACE_ROOT=/workspace/project
# 数据目录与源码分离部署时，指向含 backend/scripts 的仓库根（默认同容器内代码位置，通常不必设）
# WORKSHOP_REPO_ROOT=/workspace/project
# Docker（尤其 Windows 绑定挂载）上 SQLite 建议放在命名卷/容器内路径，勿省略（也可依赖 devops/Dockerfile.workshop 的默认 /var/lib/workshop）
# WORKSHOP_DB_PATH=/var/lib/workshop/workshop.db
# 宿主机访问端口（与 devops/Readme_design 中「生产 8601/8602、开发 8701/8702」一致；可省略，compose 有默认值）
# WORKSHOP_HOST_WEB_PORT=8601
# WORKSHOP_HOST_API_PORT=8602
WORKSHOP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8601,http://localhost:8601,http://127.0.0.1:8701,http://localhost:8701
# 可选：覆盖 ms-swift CLI 可执行文件名（默认 swift）
# WORKSHOP_SWIFT_EXECUTABLE=swift
